px-6 py-3 rounded-lg font-semibold transition shadow-md\">\r\n          Add New Topic\r\n        </button>\r\n      </div>\r\n    </div>\r\n\r\n    <div class=\"bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden\">\r\n      <table class=\"w-full text-left border-collapse\">\r\n        <thead>\r\n          <tr class=\"text-[11px] uppercase tracking-wider text-gray-400 border-b border-gray-50\">\r\n            <th class=\"px-6 py-4 font-bold\">Lesson</th>\r\n            <th class=\"px-6 py-4 font-bold\">Topic Name</th>\r\n            <th class=\"px-6 py-4 font-bold text-center\">Week</th>\r\n            <th class=\"px-6 py-4 font-bold text-center\">Status</th>\r\n            <th class=\"px-6 py-4 font-bold text-right\">Actions</th>\r\n          </tr>\r\n        </thead>\r\n        <tbody class=\"text-sm text-gray-600 divide-y divide-gray-50\">\r\n          <tr v-for=\"(topic, i) in topics\" :key=\"i\" class=\"hover:bg-purple-50/30 transition\">\r\n            <td class=\"px-6 py-5 flex items-center gap-2\">\r\n              <span class=\"w-2 h-2 rounded-full bg-cyan-400\"></span>\r\n              {{ topic.lesson }}\r\n            </td>\r\n            <td class=\"px-6 py-5 font-medium text-[#5b21b6] hover:underline cursor-pointer\">\r\n              {{ topic.name }}\r\n            </td>\r\n            <td class=\"px-6 py-5 text-center font-semibold text-gray-400\">{{ topic.week }}</td>\r\n            <td class=\"px-6 py-5 text-center\">\r\n              <span class=\"inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-green-100 text-green-600 border border-green-200 cursor-pointer\">\r\n                <span class=\"w-1.5 h-1.5 rounded-full bg-green-600\"></span>\r\n                Active <i class=\"fas fa-chevron-down text-[10px]\"></i>\r\n              </span>\r\n            </td>\r\n            <td class=\"px-6 py-5 text-right space-x-4\">\r\n              <button class=\"text-gray-400 hover:text-[#5b21b6] transition\"><i class=\"far fa-edit text-lg\"></i></button>\r\n              <button class=\"text-gray-400 hover:text-red-500 transition\"><i class=\"far fa-trash-alt text-lg\"></i></button>\r\n            </td>\r\n          </tr>\r\n        </tbody>\r\n      </table>\r\n    </div>\r\n\r\n    <div class=\"mt-8 flex justify-between items-center text-sm\">\r\n      <p class=\"text-gray-500\">Showing <span class=\"font-bold\">5</span> of <span class=\"font-bold\">48</span> topics</p>\r\n      <div class=\"flex items-center gap-4\">\r\n        <button class=\"px-4 py-2 bg-gray-200 text-gray-600 rounded-lg hover:bg-gray-300 transition\">Previous</button>\r\n        <p class=\"text-gray-500\">Page <span class=\"font-bold text-gray-800\">1</span> of <span class=\"font-bold\">10</span></p>\r\n        <button class=\"px-6 py-2 bg-[#0d5b77] text-white rounded-lg hover:bg-opacity-90 transition\">Next</button>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script setup>\r\nconst topics = [\r\n  { lesson: 'Medication Aide', name: 'Chapter 1: The Medication Aide in Healthcare Settings', week: 1 },\r\n  { lesson: 'Nurse Aide', name: 'Chapter 1: The Nursing Assistant in Long-Term Care', week: 1 },\r\n  { lesson: 'Medication Aide', name: 'Chapter 2: Ethical and Legal Issues', week: 1 },\r\n  { lesson: 'Nurse Aide', name: 'Chapter 2: Foundations of Resident Care', week: 1 },\r\n  { lesson: 'Medication Aide', name: 'Chapter 3: Medication Basics', week: 1 },\r\n];\r\n</script>"],"mappings":";;;;;;IAgHA,MAAMA,MAAM,GAAG,CACb;MAAEC,MAAM,EAAE,iBAAiB;MAAEC,IAAI,EAAE,uDAAuD;MAAEC,IAAI,EAAE;IAAE,CAAC,EACrG;MAAEF,MAAM,EAAE,YAAY;MAAEC,IAAI,EAAE,oDAAoD;MAAEC,IAAI,EAAE;IAAE,CAAC,EAC7F;MAAEF,MAAM,EAAE,iBAAiB;MAAEC,IAAI,EAAE,qCAAqC;MAAEC,IAAI,EAAE;IAAE,CAAC,EACnF;MAAEF,MAAM,EAAE,YAAY;MAAEC,IAAI,EAAE,yCAAyC;MAAEC,IAAI,EAAE;IAAE,CAAC,EAClF;MAAEF,MAAM,EAAE,iBAAiB;MAAEC,IAAI,EAAE,8BAA8B;MAAEC,IAAI,EAAE;IAAE,CAAC,CAC7E","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}