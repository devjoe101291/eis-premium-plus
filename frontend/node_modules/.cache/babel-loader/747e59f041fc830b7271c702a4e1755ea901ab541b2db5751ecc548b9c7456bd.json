{"ast":null,"code":"import { onMounted } from 'vue';\nimport { storeToRefs } from 'pinia';\n\n/* Components */\nimport MaterialTable from '@/components/MaterialTable.vue';\nimport SearchInput from '@/components/SearchInput.vue';\nimport BaseButton from '@/components/BaseButton.vue';\n\n/* Composables */\nimport { useSearchFilter } from '@/composables/useSearchFilter';\nimport { usePagination } from '@/composables/usePagination';\n\n/* Store */\nimport { useMaterialStore } from '@/stores/materialStore';\n\n/* ================================\r\n   STORE CONNECTION\r\n================================ */\n\nexport default {\n  __name: 'MaterialView',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n\n    /* ================================\r\n       VIEWS – page orchestration\r\n    ================================ */\n    const materialStore = useMaterialStore();\n    const {\n      materials,\n      totalItems,\n      activeItems,\n      inactiveItems,\n      loading\n    } = storeToRefs(materialStore);\n\n    /* ================================\r\n       COMPOSABLE LOGIC\r\n    ================================ */\n    const {\n      search,\n      filteredItems\n    } = useSearchFilter(materials);\n    const {\n      paginatedItems,\n      currentPage,\n      totalPages,\n      setPage\n    } = usePagination(filteredItems);\n\n    /* ================================\r\n       LIFECYCLE\r\n    ================================ */\n    onMounted(() => {\n      materialStore.fetchMaterials();\n    });\n\n    /* ================================\r\n       ACTIONS\r\n    ================================ */\n    const handleAddMaterial = () => {\n      // open modal or redirect\n      console.log('Add new material');\n    };\n    const __returned__ = {\n      materialStore,\n      materials,\n      totalItems,\n      activeItems,\n      inactiveItems,\n      loading,\n      search,\n      filteredItems,\n      paginatedItems,\n      currentPage,\n      totalPages,\n      setPage,\n      handleAddMaterial,\n      onMounted,\n      get storeToRefs() {\n        return storeToRefs;\n      },\n      MaterialTable,\n      SearchInput,\n      BaseButton,\n      get useSearchFilter() {\n        return useSearchFilter;\n      },\n      get usePagination() {\n        return usePagination;\n      },\n      get useMaterialStore() {\n        return useMaterialStore;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["onMounted","storeToRefs","MaterialTable","SearchInput","BaseButton","useSearchFilter","usePagination","useMaterialStore","materialStore","materials","totalItems","activeItems","inactiveItems","loading","search","filteredItems","paginatedItems","currentPage","totalPages","setPage","fetchMaterials","handleAddMaterial","console","log"],"sources":["C:/Users/Production/Documents/Web2 - Jess Rey/Task/Repos/Internal Tasks/Premium Plus Employee-in-Service System/lara-vue-template/frontend/src/views/MaterialView.vue"],"sourcesContent":["<template>\r\n  <div class=\"space-y-4\">\r\n    <!-- STATS BAR -->\r\n    <div class=\"grid grid-cols-1 sm:grid-cols-3 gap-4\">\r\n      <div\r\n        class=\"bg-white/80 dark:bg-slate-800/80 backdrop-blur-sm\r\n               rounded-2xl shadow-lg border border-slate-200/50\r\n               dark:border-slate-700/50 p-4 flex items-center justify-between\"\r\n      >\r\n        <div>\r\n          <p class=\"text-xs text-slate-500 dark:text-slate-400\">Total Materials</p>\r\n          <p class=\"text-2xl font-bold text-slate-800 dark:text-slate-200\">\r\n            {{ totalItems }}\r\n          </p>\r\n        </div>\r\n        <div class=\"bg-slate-100 dark:bg-slate-700 p-2 rounded-lg\">\r\n          <svg class=\"w-6 h-6 text-slate-600 dark:text-slate-300\" fill=\"currentColor\">\r\n            <use xlink:href=\"#icon-book\" />\r\n          </svg>\r\n        </div>\r\n      </div>\r\n\r\n      <div\r\n        class=\"bg-white/80 dark:bg-slate-800/80 backdrop-blur-sm\r\n               rounded-2xl shadow-lg border border-slate-200/50\r\n               dark:border-slate-700/50 p-4 flex items-center justify-between\"\r\n      >\r\n        <div>\r\n          <p class=\"text-xs text-slate-500 dark:text-slate-400\">Active</p>\r\n          <p class=\"text-2xl font-bold text-slate-800 dark:text-slate-200\">\r\n            {{ activeItems }}\r\n          </p>\r\n        </div>\r\n        <div class=\"bg-green-100 dark:bg-green-700/30 p-2 rounded-lg\">\r\n          <svg class=\"w-6 h-6 text-green-700 dark:text-green-300\" fill=\"currentColor\">\r\n            <use xlink:href=\"#icon-check\" />\r\n          </svg>\r\n        </div>\r\n      </div>\r\n\r\n      <div\r\n        class=\"bg-white/80 dark:bg-slate-800/80 backdrop-blur-sm\r\n               rounded-2xl shadow-lg border border-slate-200/50\r\n               dark:border-slate-700/50 p-4 flex items-center justify-between\"\r\n      >\r\n        <div>\r\n          <p class=\"text-xs text-slate-500 dark:text-slate-400\">Inactive</p>\r\n          <p class=\"text-2xl font-bold text-slate-800 dark:text-slate-200\">\r\n            {{ inactiveItems }}\r\n          </p>\r\n        </div>\r\n        <div class=\"bg-red-100 dark:bg-red-700/30 p-2 rounded-lg\">\r\n          <svg class=\"w-6 h-6 text-red-700 dark:text-red-300\" fill=\"currentColor\">\r\n            <use xlink:href=\"#icon-x\" />\r\n          </svg>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- SEARCH + ADD BUTTON -->\r\n    <div\r\n      class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\"\r\n    >\r\n      <input\r\n        type=\"text\"\r\n        v-model=\"searchQuery\"\r\n        placeholder=\"Search materials by name...\"\r\n        class=\"w-full sm:w-1/2 px-4 py-2 rounded-lg border border-slate-300 dark:border-slate-600 focus:outline-none focus:ring-2 focus:ring-blue-400 dark:bg-slate-700 dark:text-slate-200\"\r\n      />\r\n\r\n      <button\r\n        @click=\"openAddMaterial\"\r\n        class=\"w-full sm:w-auto px-6 py-2 bg-gradient-to-r from-blue-500 to-green-400\r\n               text-white font-semibold rounded-lg shadow hover:opacity-90 transition\"\r\n      >\r\n        Add New Material\r\n      </button>\r\n    </div>\r\n\r\n    <!-- TABLE ONLY -->\r\n    <div\r\n      class=\"bg-white/80 dark:bg-slate-800/80 backdrop-blur-sm\r\n             rounded-2xl shadow-lg border border-slate-200/50\r\n             dark:border-slate-700/50 overflow-hidden\"\r\n    >\r\n      <table class=\"w-full\">\r\n        <thead class=\"bg-slate-100 dark:bg-slate-700\">\r\n          <tr class=\"border-b border-slate-200 dark:border-slate-600\">\r\n            <th class=\"px-6 py-4 text-left text-xs font-semibold uppercase\">Title</th>\r\n            <th class=\"px-6 py-4 text-left text-xs font-semibold uppercase\">Description</th>\r\n            <th class=\"px-6 py-4 text-left text-xs font-semibold uppercase\">File Type</th>\r\n            <th class=\"px-6 py-4 text-left text-xs font-semibold uppercase\">Filename</th>\r\n            <th class=\"px-6 py-4 text-left text-xs font-semibold uppercase\">Status</th>\r\n            <th class=\"px-6 py-4 text-left text-xs font-semibold uppercase\">Created By</th>\r\n            <th class=\"px-6 py-4 text-center text-xs font-semibold uppercase\">Actions</th>\r\n          </tr>\r\n        </thead>\r\n\r\n        <tbody class=\"divide-y divide-slate-200 dark:divide-slate-700\">\r\n          <tr\r\n            v-for=\"item in filteredPaginatedItems\"\r\n            :key=\"item.id\"\r\n            class=\"hover:bg-slate-50 dark:hover:bg-slate-700/50 transition\"\r\n          >\r\n            <td class=\"px-6 py-4 font-medium text-slate-800 dark:text-slate-200\">\r\n              {{ item.title }}\r\n            </td>\r\n\r\n            <td class=\"px-6 py-4 text-sm text-slate-600 dark:text-slate-400 truncate max-w-xs\">\r\n              {{ item.description || '—' }}\r\n            </td>\r\n\r\n            <td class=\"px-6 py-4 text-sm\">\r\n              {{ item.file_type }}\r\n            </td>\r\n\r\n            <td class=\"px-6 py-4 text-sm text-[#005D84] dark:text-[#71D8BD]\">\r\n              {{ item.filename }}\r\n            </td>\r\n\r\n            <td class=\"px-6 py-4\">\r\n              <span\r\n                class=\"px-3 py-1 text-xs font-semibold rounded-full\"\r\n                :class=\"item.status === 'active'\r\n                  ? 'bg-green-100 text-green-700'\r\n                  : 'bg-red-100 text-red-700'\"\r\n              >\r\n                {{ item.status }}\r\n              </span>\r\n            </td>\r\n\r\n            <td class=\"px-6 py-4 text-sm text-slate-600 dark:text-slate-400\">\r\n              {{ item.created_by }}\r\n            </td>\r\n\r\n            <td class=\"px-6 py-4 text-center\">\r\n              <div class=\"flex justify-center gap-2\">\r\n                <button @click=\"onEdit(item)\" class=\"icon-btn\">\r\n                  <Pencil :size=\"16\" />\r\n                </button>\r\n                <button @click=\"onDelete(item.id)\" class=\"icon-btn text-red-500\">\r\n                  <Trash2 :size=\"16\" />\r\n                </button>\r\n              </div>\r\n            </td>\r\n          </tr>\r\n\r\n          <!-- Empty state -->\r\n          <tr v-if=\"filteredPaginatedItems.length === 0\">\r\n            <td colspan=\"7\" class=\"text-center py-12 text-slate-500\">\r\n              No records found\r\n            </td>\r\n          </tr>\r\n        </tbody>\r\n      </table>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n\r\n\r\n<!-- <script lang=\"ts\">\r\nimport { defineComponent, ref, computed, onMounted } from 'vue'\r\nimport { Pencil, Trash2 } from 'lucide-vue-next'\r\nimport { useToast } from '@/composables/ui/useToast'\r\nimport { MaterialApi } from '@/services/MaterialServices'\r\n\r\nexport default defineComponent({\r\n  name: 'MaterialsView',\r\n  components: { Pencil, Trash2 },\r\n\r\n  setup() {\r\n    const { success, error } = useToast()\r\n\r\n    /* =======================\r\n     * STATE\r\n     * ======================= */\r\n    const items = ref<any[]>([])\r\n    const isLoading = ref(false)\r\n\r\n    const currentPage = ref(1)\r\n    const perPage = ref(10)\r\n\r\n    /* =======================\r\n     * FETCH\r\n     * ======================= */\r\n    const fetchMaterials = async () => {\r\n      try {\r\n        isLoading.value = true\r\n        items.value = await MaterialApi.getMaterials()\r\n      } catch {\r\n        error('Failed to load materials')\r\n      } finally {\r\n        isLoading.value = false\r\n      }\r\n    }\r\n\r\n    /* =======================\r\n     * PAGINATION\r\n     * ======================= */\r\n    const totalItems = computed(() => items.value.length)\r\n\r\n    const totalPages = computed(() =>\r\n      Math.ceil(totalItems.value / perPage.value)\r\n    )\r\n\r\n    const paginatedItems = computed(() => {\r\n      const start = (currentPage.value - 1) * perPage.value\r\n      return items.value.slice(start, start + perPage.value)\r\n    })\r\n\r\n    const goToPage = (page: number) => {\r\n      if (page < 1 || page > totalPages.value) return\r\n      currentPage.value = page\r\n    }\r\n\r\n    /* =======================\r\n     * ACTIONS\r\n     * ======================= */\r\n    const onEdit = (item: any) => {\r\n      // route or emit if needed\r\n      console.log('Edit item:', item)\r\n    }\r\n\r\n    const onDelete = async (id: number) => {\r\n      try {\r\n        await MaterialApi.deleteMaterial(id)\r\n        items.value = items.value.filter(i => i.id !== id)\r\n        success('Material deleted')\r\n      } catch {\r\n        error('Failed to delete material')\r\n      }\r\n    }\r\n\r\n    /* =======================\r\n     * LIFECYCLE\r\n     * ======================= */\r\n    onMounted(fetchMaterials)\r\n\r\n    /* =======================\r\n     * RETURN\r\n     * ======================= */\r\n    return {\r\n      isLoading,\r\n\r\n      paginatedItems,\r\n      currentPage,\r\n      totalPages,\r\n      totalItems,\r\n      goToPage,\r\n\r\n      onEdit,\r\n      onDelete,\r\n    }\r\n  },\r\n})\r\n</script> -->\r\n\r\n\r\n<script setup>\r\n/* ================================\r\n   VIEWS – page orchestration\r\n================================ */\r\nimport { onMounted } from 'vue'\r\nimport { storeToRefs } from 'pinia'\r\n\r\n/* Components */\r\nimport MaterialTable from '@/components/MaterialTable.vue'\r\nimport SearchInput from '@/components/SearchInput.vue'\r\nimport BaseButton from '@/components/BaseButton.vue'\r\n\r\n/* Composables */\r\nimport { useSearchFilter } from '@/composables/useSearchFilter'\r\nimport { usePagination } from '@/composables/usePagination'\r\n\r\n/* Store */\r\nimport { useMaterialStore } from '@/stores/materialStore'\r\n\r\n/* ================================\r\n   STORE CONNECTION\r\n================================ */\r\nconst materialStore = useMaterialStore()\r\nconst {\r\n  materials,\r\n  totalItems,\r\n  activeItems,\r\n  inactiveItems,\r\n  loading\r\n} = storeToRefs(materialStore)\r\n\r\n/* ================================\r\n   COMPOSABLE LOGIC\r\n================================ */\r\nconst { search, filteredItems } = useSearchFilter(materials)\r\n\r\nconst {\r\n  paginatedItems,\r\n  currentPage,\r\n  totalPages,\r\n  setPage\r\n} = usePagination(filteredItems)\r\n\r\n/* ================================\r\n   LIFECYCLE\r\n================================ */\r\nonMounted(() => {\r\n  materialStore.fetchMaterials()\r\n})\r\n\r\n/* ================================\r\n   ACTIONS\r\n================================ */\r\nconst handleAddMaterial = () => {\r\n  // open modal or redirect\r\n  console.log('Add new material')\r\n}\r\n</script>\r\n"],"mappings":"AAuQA,SAASA,SAAS,QAAQ,KAAK;AAC/B,SAASC,WAAW,QAAQ,OAAO;;AAEnC;AACA,OAAOC,aAAa,MAAM,gCAAgC;AAC1D,OAAOC,WAAW,MAAM,8BAA8B;AACtD,OAAOC,UAAU,MAAM,6BAA6B;;AAEpD;AACA,SAASC,eAAe,QAAQ,+BAA+B;AAC/D,SAASC,aAAa,QAAQ,6BAA6B;;AAE3D;AACA,SAASC,gBAAgB,QAAQ,wBAAwB;;AAEzD;AACA;AACA;;;;;;;;;IApBA;AACA;AACA;IAmBA,MAAMC,aAAa,GAAGD,gBAAgB,CAAC,CAAC;IACxC,MAAM;MACJE,SAAS;MACTC,UAAU;MACVC,WAAW;MACXC,aAAa;MACbC;IACF,CAAC,GAAGZ,WAAW,CAACO,aAAa,CAAC;;IAE9B;AACA;AACA;IACA,MAAM;MAAEM,MAAM;MAAEC;IAAc,CAAC,GAAGV,eAAe,CAACI,SAAS,CAAC;IAE5D,MAAM;MACJO,cAAc;MACdC,WAAW;MACXC,UAAU;MACVC;IACF,CAAC,GAAGb,aAAa,CAACS,aAAa,CAAC;;IAEhC;AACA;AACA;IACAf,SAAS,CAAC,MAAM;MACdQ,aAAa,CAACY,cAAc,CAAC,CAAC;IAChC,CAAC,CAAC;;IAEF;AACA;AACA;IACA,MAAMC,iBAAiB,GAAGA,CAAA,KAAM;MAC9B;MACAC,OAAO,CAACC,GAAG,CAAC,kBAAkB,CAAC;IACjC,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}